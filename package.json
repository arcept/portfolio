{
  "name": "manik-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:oms": "node prototype/oms-v3/build.js",
    "build:oms-rebuild": "npm --prefix products/oms run build && node scripts/sync-oms-rebuild.js",
    "build:placement-hub": "npm --prefix products/placement-hub run build && node scripts/sync-placement-hub.js",
    "start": "next start",
    "lint": "next lint",
    "test:narration": "node --test \"components/narration/*.test.mjs\"",
    "test:narration:tools": "python3 -m unittest discover -s docs/narration -p \"test_*.py\"",
    "validate:narration": "node scripts/validate-narration.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "narration:script": "python3 docs/narration/narrate.py script",
    "narration:align": "docs/narration/.venv/bin/python docs/narration/narrate.py align",
    "narration:publish": "python3 docs/narration/narrate.py publish"
  },
  "dependencies": {
    "motion": "^13.1.1",
    "next": "^16.3.2",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
