      },
      "action": "Rate experience",
      "note": "The celebration and the rating ask are the same moment now, not two separate screens.",
      "chapter": "Outcome"
    },
    {
      "n": 15,
      "screen": "popup-offer-accepted-2",
      "action": "Submit",
      "note": "",
      "chapter": "Outcome"
    },
    {
      "n": 16,
      "screen": "popup-offer-accepted-3",
      "action": "advance",
      "note": "",
      "chapter": "Outcome"
    },
    {
      "n": 17,
      "screen": "popup-offer-accepted-4",
      "action": "auto 10s → home",
      "note": "",
      "chapter": "Outcome"
    },
    {
      "n": 18,
      "screen": "home-placed",
      "action": "end",
      "note": "Focus mode: other pages restricted. Closure is designed, not an absence. End of path.",
      "chapter": "Outcome"
    }
