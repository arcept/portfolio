{
  "id": "happy-path",
  "tier": "hero",
  "title": "From graduation to placed",
  "proves": [
    "State is always visible",
    "The four moments: first entry, browsing, applying, outcome",
    "Status lives on the JD itself"
  ],
  "initialState": {
    "stage": "evaluation_day",
    "eligibility": "not_assessed",
    "profile": "complete",
    "interest": "interested",
    "standing": "active",
